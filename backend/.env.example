# Copy this file to .env for local development overrides.

POSTGRES_DB=ingestion
POSTGRES_USER=ingestion
POSTGRES_PASSWORD=ingestion
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_CONTAINER_HOST=postgres
# Optional override. When omitted, the app builds DATABASE_URL from the
# POSTGRES_* values above. Docker Compose supplies its own container URL.
# DATABASE_URL=postgresql+psycopg://ingestion:ingestion@localhost:5432/ingestion
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

RABBITMQ_USER=ingestion
RABBITMQ_PASSWORD=ingestion
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=localhost
RABBITMQ_CONTAINER_HOST=rabbitmq

REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_CONTAINER_HOST=redis

FLOCI_PORT=4566
FLOCI_HOST=localhost
FLOCI_CONTAINER_HOST=floci
FLOCI_ENDPOINT_URL=http://localhost:4566
FLOCI_CONTAINER_ENDPOINT_URL=http://floci:4566
# Presigned URLs returned to React must use a host-browser reachable endpoint.
FLOCI_BROWSER_ENDPOINT_URL=http://localhost:4566
FLOCI_ACCESS_KEY_ID=test
FLOCI_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_UPLOAD_BUCKET=csv-ingestion-uploads
UPLOAD_PART_SIZE_BYTES=8388608
MAX_UPLOAD_SIZE_BYTES=5368709120
PART_URL_BATCH_LIMIT=100
PRESIGNED_URL_EXPIRATION_SECONDS=900
WORKER_CHECKPOINT_ROWS=1000
WORKER_MAX_RETRIES=3

# Create React App uses port 3000 by default. This same origin is allowed by
# FastAPI and by the Floci S3 bucket CORS policy.
REACT_ORIGIN=http://localhost:3000

API_PORT=8000
API_HOST=localhost
