# Backend settings. The app reads them from the environment only.
# Docker Compose sets them for its containers and reads the POSTGRES_*,
# RABBITMQ_* and *_PORT values from a .env file next to docker-compose.yml.
# To run a backend process outside Compose: set -a; source .env; set +a

APP_PORT=8000
LOG_LEVEL=INFO

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ingestion
POSTGRES_USER=ingestion
POSTGRES_PASSWORD=ingestion
# Optional. When set, it replaces the POSTGRES_* values above.
# DATABASE_URL=postgresql+psycopg://ingestion:ingestion@localhost:5432/ingestion
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

RABBITMQ_USER=ingestion
RABBITMQ_PASSWORD=ingestion
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
CELERY_BROKER_URL=amqp://ingestion:ingestion@localhost:5672//

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Leave both endpoints unset for AWS S3. Credentials come from boto3's
# default chain: these variables, a profile, or an IAM role.
FLOCI_PORT=4566
S3_ENDPOINT_URL=http://localhost:4566
# Endpoint in presigned URLs, which the browser calls. Defaults to S3_ENDPOINT_URL.
S3_BROWSER_ENDPOINT_URL=http://localhost:4566
S3_UPLOAD_BUCKET=csv-ingestion-uploads
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

UPLOAD_PART_SIZE_BYTES=8388608
MAX_UPLOAD_SIZE_BYTES=5368709120
PART_URL_BATCH_LIMIT=100
PRESIGNED_URL_EXPIRATION_SECONDS=900
WORKER_CHECKPOINT_ROWS=1000
WORKER_MAX_RETRIES=3

# Origin of the page. FastAPI and the bucket's CORS policy allow it.
REACT_ORIGIN=http://localhost:8000
