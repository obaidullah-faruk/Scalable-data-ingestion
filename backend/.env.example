# Copy this file to .env for local development overrides.

POSTGRES_DB=ingestion
POSTGRES_USER=ingestion
POSTGRES_PASSWORD=ingestion
POSTGRES_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_CONTAINER_HOST=postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800

RABBITMQ_USER=ingestion
RABBITMQ_PASSWORD=ingestion
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_HOST=localhost
RABBITMQ_CONTAINER_HOST=rabbitmq

REDIS_PORT=6379
REDIS_HOST=localhost
REDIS_CONTAINER_HOST=redis

FLOCI_PORT=4566
FLOCI_HOST=localhost
FLOCI_CONTAINER_HOST=floci
FLOCI_ENDPOINT_URL=http://localhost:4566
FLOCI_CONTAINER_ENDPOINT_URL=http://floci:4566
FLOCI_ACCESS_KEY_ID=test
FLOCI_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

API_PORT=8000
API_HOST=localhost
